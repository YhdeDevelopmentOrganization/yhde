<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>YHDE.Server</AssemblyName>
    <RootNamespace>YHDE.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- PostgreSQL driver -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <!-- Micro-ORM for precise SQL control (append-only log) -->
    <PackageReference Include="Dapper" Version="2.1.35" />
    <!-- Binary wire codec -->
    <PackageReference Include="MessagePack" Version="3.1.10" />
    <!-- SQL migration runner -->
    <PackageReference Include="DbUp-PostgreSQL" Version="5.0.40" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed SQL migration scripts as resources -->
    <EmbeddedResource Include="Persistence\Migrations\*.sql" />
    <!-- The admin and join pages, built from server/admin-ui (npm run build), served from ui/ -->
    <Content Include="../../admin-ui/dist/**" Link="ui/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
